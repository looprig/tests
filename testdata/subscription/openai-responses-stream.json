{
  "model": "fixture-alias",
  "instructions": "Return a structured fixture answer.",
  "reasoning": {"effort": "high", "summary": "auto"},
  "text": {
    "format": {
      "type": "json_schema",
      "name": "fixture_answer",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {"answer": {"type": "string"}},
        "required": ["answer"],
        "additionalProperties": false
      }
    }
  },
  "tools": [
    {
      "type": "function",
      "name": "lookup_fixture",
      "description": "Look up fixture data.",
      "parameters": {
        "type": "object",
        "properties": {"key": {"type": "string"}},
        "required": ["key"],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": "required",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        {"type": "input_text", "text": "Use the image and tool."},
        {"type": "input_image", "image_url": "data:image/png;base64,aGVsbG8=", "detail": "auto"}
      ]
    }
  ],
  "stream": true,
  "store": false
}
